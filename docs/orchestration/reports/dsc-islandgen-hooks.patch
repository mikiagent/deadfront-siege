+		# Palms grow near the shore: the outer 20 % of the effective radius (not a circle).
+		if palms and rt.rad_at(cx, cz) > rt.land_radius() * 0.78:
 			fam = "PalmTree"
 		var clump := rng.randi_range(3, 6) if (role.begins_with("tree") or role == "bush") else rng.randi_range(1, 3)
 		var spread := 3.2 if role.begins_with("tree") else 2.4
@@ -281,7 +285,7 @@ static func _multimesh_family(rt: IslandRuntime, family: String, n: int, size: f
 	if src_mesh == null:
 		return
 	var xforms: Array[Transform3D] = []
-	var half := size * 0.42
+	var half := size * 0.5 - 15.0
 	for i in n:
 		var ox := rng.randf_range(-half, half)
 		var oz := rng.randf_range(-half, half)
diff --git a/game/scripts/world/water.gdshader b/game/scripts/world/water.gdshader
index 5c2eccb8..39830d45 100644
--- a/game/scripts/world/water.gdshader
+++ b/game/scripts/world/water.gdshader
@@ -28,7 +28,9 @@ void fragment() {
 	float depth = max(0.0, water_y - ground);
 	float d = clamp(depth / 1.6, 0.0, 1.0);
 	vec3 col = mix(shallow_col, deep_col, d);
-	float alpha = mix(0.22, 0.90, smoothstep(0.0, 1.3, depth));
+	// Shallow water is still water: the river is only ~0.3 m deep over its bed and used to read as
+	// a brown trench of mud. The floor is high enough that a channel reads blue-green at a glance.
+	float alpha = mix(0.62, 0.95, smoothstep(0.0, 1.3, depth));
 
 	float t = TIME;
 	float f1 = texture(noise_tex, world_pos.xz / 7.0 + vec2(t * 0.05, t * 0.03)).r;
# NOTE (not a patch hunk): island_terrain.gd is ISLANDGEN's file this run, so its diff is in the branch, not
# here. BIOMEZONES must build the zone map ON TOP of that tile loop, not replace it:
#   * _build_tile_types reads only IslandShape's packed arrays (height, eff radius, river distance/width,
#     per-vertex slope) and fills rt.dry_walk (is_dry's single-lookup mask) and TileType.CLIFF = 11
#     (slope > 1.15 rise/run outside the river's banks). Keep both: pathing, build checks and spawns use them.
#   * The tile image is FORMAT_R8 built from a PackedByteArray; zone ids belong in the G channel of an
#     RG8 map, and set_tile_type must preserve G (see the scout prototype patch).
#   * _shader_id() maps CLIFF to GRASS so the shader's slope band paints the face; CLIFF keeps a rock
#     colour in _tile_color for the minimap/atlas.
#   * data/islands/*.json and world/islands.json now carry "seed" and "size_m" (tundra_30 is on the 416
#     square); the generator is deterministic from them. Do not remove them.
#   * water.gdshader above raises shallow-water alpha to >= 0.62 so the 0.3 m river reads as water.
