+## Inside a ScrollContainer below `top` (a scrolled list's rows may sit past the view on purpose).
+func _in_scroll(c: Node, top: Node) -> bool:
+	var n := c.get_parent()
+	while n != null and n != top:
+		if n is ScrollContainer:
+			return true
+		n = n.get_parent()
+	return false
