index 1bd8b68a..48b2cda2 100644
--- a/game/scripts/player/player_equipment.gd
+++ b/game/scripts/player/player_equipment.gd
@@ -3,9 +3,16 @@ extends Node
 ## Shows worn armor on the survivor. The single survivor mesh is swapped for four body regions; each
 ## head/body/arms/legs item with a "visual" ("<kit>/<piece>") attaches that kit piece to the live skeleton
 ## and hides the body regions its kit.json lists. Every clip keeps working: pieces share the base bones.
+## set_hair() swaps the head region and adds a "hair" region for the chosen hairstyle.
 
 const ROOT := "res://assets/characters/survivor"
 const PIECE_FOR_SLOT := {&"head": "helmet", &"body": "chest", &"arms": "arms", &"legs": "legs"}
+## Today's hair as its own piece on the bald head (game/data/characters/appearance.json "hair" row "current").
+## body_helmet.glb is the same triangles in one mesh and stays the default head: split in two, each mesh gets
+## its own LODs and the head shifts a few pixels in the world view.
+const HEAD := ROOT + "/hair/head.glb"
+const HAIR := ROOT + "/hair/hair_current.glb"
+const HEAD_WITH_HAIR := ROOT + "/body/body_helmet.glb"
 
 var rig: RiggedModel
 var inventory: Inventory
@@ -34,6 +41,31 @@ func setup(p_rig: RiggedModel, p_inventory: Inventory) -> void:
 	inventory.changed.connect(refresh)
 	refresh()
 
+## Hair option (appearance.json "hair" row): `head` replaces the "helmet" region (the head with that option's
+## scalp paint) and `hair` fills the "hair" region that kits hide ("" = no piece). "" for both = today's look.
+func set_hair(head: String, hair: String) -> void:
+	if body.is_empty():
+		return
+	if head == "" or (head == HEAD and hair == HAIR):
+		head = HEAD_WITH_HAIR
+		hair = ""
+	_swap_region("helmet", head)
+	_swap_region("hair", hair)
+	_sync_body()
+
+func _swap_region(region: String, path: String) -> void:
+	if path != "" and not ResourceLoader.exists(path):
+		push_warning("[equipment] no %s piece at %s" % [region, path])
+		return
+	for m in body.get(region, []):
+		(m as Node).queue_free()
+	var meshes: Array[MeshInstance3D] = []
+	if path != "":
+		meshes = RiggedModel.attach_skinned(rig.skeleton, path)
+	for m in meshes:
+		PlayerView.web_safe_mesh(m)
+	body[region] = meshes
+
 ## Equip or unequip whatever differs between the inventory and what is shown.
 func refresh() -> void:
 	if rig == null or rig.skeleton == null:
