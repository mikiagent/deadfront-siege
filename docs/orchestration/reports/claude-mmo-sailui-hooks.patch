 func def_of(id: StringName) -> Dictionary:
 	return islands.get(str(id), {}) as Dictionary
 
+## The island's name for people, one rule for the Sail chart and the map: its data display_name
+## (home's "Private Grassland", the standing order's "Unstable Temperate"), else "<Climate> Island".
+## Callers show the level beside it, as Durango's "Tropical Sea Lv. 18" and "Lv. 25" do.
+func island_name(id: StringName) -> String:
+	var def := def_of(id)
+	var dn := str(def.get("display_name", ""))
+	if dn == "" or dn == str(id).replace("_", " ").capitalize():
+		var climate := str(def.get("climate", ""))
+		return ("%s Island" % climate.capitalize()) if climate != "" else str(id).replace("_", " ").capitalize()
+	return dn
+
 func _boot() -> void:
 	if Game.smoke_test:
 		return
