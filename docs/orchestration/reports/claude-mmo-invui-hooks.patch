+		return false
+	p.inventory.set_equipped_tool_index(index)
+	return true
+
+## Lock or unlock the instance at bag `index` (spec 13 s9). shortcut: online it is queued with no
+## server op yet; W3 adds one.
+func set_locked(index: int, on: bool) -> bool:
+	if online:
+		return _send(&"lock", {"bag_slot": index, "on": on})
+	var s := p.inventory.slots[index] if index >= 0 and index < p.inventory.slot_count else null
+	if s == null or s.def_id == Inventory.LOCK:
+		return false
+	s.set_flag(&"locked", on)
+	p.inventory.changed.emit()
+	return true
+
