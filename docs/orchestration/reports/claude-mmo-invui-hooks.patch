+## Wear the exact bag instance (spec 13 s12: never the first of its id). Online the server picks the
+## slot from the item (act.equip {bag_slot}).
+func equip_at(index: int, slot: StringName = &"") -> bool:
+	if online:
+		return _send(&"equip", {"bag_slot": index})
+	var ok := p.inventory.equip_at(index, slot)
+	if ok:
+		p.refresh_equipment_vitals()
+	return ok
+
+## Gear back into the bag; refused (stays worn) when the bag is full.
+func unequip(slot: StringName) -> bool:
+	if online:
+		return _send(&"equip", {"slot": str(slot), "clear": true})
+	var ok := p.inventory.unequip(slot)
+	if ok:
+		p.refresh_equipment_vitals()
+	return ok
+
+## Hold the work tool at bag `index` (the server keeps it as ch.d.tool).
+func hold_tool(index: int) -> bool:
+	if online:
+		return _send(&"equip", {"bag_slot": index})
+	var s := p.inventory.slots[index] if index >= 0 and index < p.inventory.slot_count else null
+	if s == null or s.is_locked() or s.def() == null or s.def().tool_class in [&"", &"none"]:
+		return false
+	p.inventory.set_equipped_tool_index(index)
+	return true
+
+## Lock or unlock the instance at bag `index` (spec 13 s9). shortcut: online it is queued with no
+## server op yet; W3 adds one.
+func set_locked(index: int, on: bool) -> bool:
+	if online:
+		return _send(&"lock", {"bag_slot": index, "on": on})
+	var s := p.inventory.slots[index] if index >= 0 and index < p.inventory.slot_count else null
+	if s == null or s.def_id == Inventory.LOCK:
+		return false
+	s.set_flag(&"locked", on)
+	p.inventory.changed.emit()
+	return true
+
