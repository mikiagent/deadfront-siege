+## One ingredient as a 44 px button: "Berry 1/1", or the chosen instance ("Berry Lv. 25") in the
+## selection gold. Tapping opens the picker on that slot (nothing to choose when short).
+func _ingredient_button(rec: Dictionary, i: int, sample_id: StringName, nm: String, have: int, need: int) -> Button:
+	var b := Button.new()
+	b.flat = true
+	b.focus_mode = Control.FOCUS_ALL
+	b.icon = ItemIcons.texture(sample_id)
+	b.add_theme_constant_override("icon_max_width", 24)
+	b.custom_minimum_size = Vector2(0, UiTokens.TARGET_MIN)
+	b.add_theme_font_size_override("font_size", 14)
+	var picked := _chosen_slots(rec, i)
+	b.text = "%s %d/%d" % [nm, mini(have, need), need]
+	if not picked.is_empty(): # the chosen instance's own art and name (a slot takes several kinds)
+		var st := player.inventory.slots[picked[0]]
+		b.icon = ItemIcons.texture(st.def_id)
+		var cd := st.def()
+		var cn := cd.display_name if cd and cd.display_name != "" else LevelDisplay.nice_name(str(st.def_id))
+		b.text = ("%s %s" % [cn, LevelDisplay.label(st.level)]) if picked.size() == 1 else ("%s ×%d chosen" % [cn, picked.size()])
+	var tone := InvTheme.SELECT if not picked.is_empty() else (Color(0.8, 0.85, 0.75) if have >= need else Color(1.0, 0.55, 0.45))
+	for c in ["font_color", "font_hover_color", "font_focus_color", "font_pressed_color"]:
+		b.add_theme_color_override(c, tone)
+	b.disabled = have < need
+	b.tooltip_text = "Choose which ones to use"
+	b.pressed.connect(_pick_ingredient.bind(rec, i))
+	return b
+
+## Opens the Bag's ingredient picker on recipe slot `i` (spec 13 s19). The menu steps aside while it
+## is up and comes back on this recipe when it closes.
+func _pick_ingredient(rec: Dictionary, i: int) -> void:
+	if player == null or player.ui == null or not player.ui.has_method("open_picker"):
+		return
+	var rid := str(rec.get("id", ""))
+	var taken: Array = []
+	for k in _chosen.keys() if _chosen_rid == rid else []:
+		if int(k) != i:
+			taken.append_array(_chosen_slots(rec, int(k)))
+	hide_ui()
+	player.ui.open_picker(StringName(rid), i, func(picked: Array) -> void: _set_chosen(rid, i, picked), taken,
+		func() -> void: show_ui(); _choose_recipe(rid))
+
+func _set_chosen(rid: String, i: int, picked: Array) -> void:
+	if _chosen_rid != rid:
+		_chosen = {}
+		_chosen_rid = rid
+	var keys: Array[String] = []
+	for k: Variant in picked:
+		var st := player.inventory.slots[int(k)]
+		keys.append(st.uid if st.uid != "" else "#%d" % int(k))
+	_chosen[i] = keys
+
+## Bag slots chosen for recipe slot `i` that are still in the bag; [] when none or one left.
+func _chosen_slots(rec: Dictionary, i: int) -> Array[int]:
+	var out: Array[int] = []
+	if _chosen_rid != str(rec.get("id", "")) or not _chosen.has(i):
+		return out
+	var inv := player.inventory
+	for key: String in _chosen[i]:
+		var at := -1
+		if key.begins_with("#"):
+			var j := int(key.substr(1))
+			at = j if j >= 0 and j < inv.slot_count and inv.slots[j] else -1
+		else:
+			for j in inv.slot_count:
+				if inv.slots[j] and inv.slots[j].uid == key:
+					at = j
+		if at < 0: # one of them left the bag: the choice is void, the default applies
+			out.clear()
+			return out
+		out.append(at)
+	return out
+
+## Picks for Craft: the chosen instances where the player chose, the default lead elsewhere;
+## [] (the default plan) when nothing is chosen or the choice no longer makes the recipe.
+func _picks_for(rec: Dictionary) -> Array:
+	var picks: Array = []
+	var any := false
+	var defaults := Crafting.default_picks(player.inventory, rec)
+	for i in defaults.size():
+		var mine := _chosen_slots(rec, i)
+		any = any or not mine.is_empty()
+		picks.append(mine if not mine.is_empty() else defaults[i])
+	return picks if any and Crafting.picks_valid(player.inventory, rec, picks) else []
+
+## Spec 13 s19 "do not automatically consume the most valuable item": the first recipe slot whose
+## default would spend an instance with traits (W2-INV Inventory.traits) the player did not choose.
+func _trait_slot(rec: Dictionary, picks: Array) -> int:
+	var rows := Crafting.plan(player.inventory, rec, picks)
+	for i in rows.size():
+		if i < picks.size() and picks[i] is Array:
+			continue
+		for part: Dictionary in rows[i].parts:
+			if not Inventory.traits(player.inventory.slots[int(part.idx)]).is_empty():
+				return i
+	return -1
