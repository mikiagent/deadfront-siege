+## Step i as objectives.json defines it ({} past the list): the walkthrough finger reads its target from it.
+static func step(i: int) -> Dictionary:
+	var steps := _steps()
+	return steps[i] if i >= 0 and i < steps.size() and steps[i] is Dictionary else {}
