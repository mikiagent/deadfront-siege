+## A HUD control the walkthrough finger points at: craft opens from the MENU hex (Menu, then Craft).
+func control_for(id: StringName) -> Control:
+	return _menu_hex if id == &"craft" else null
+
+## True while a sheet, a modal screen (bag, craft, atlas, animals), the creature plate or the death screen
+## is up: the walkthrough finger hides meanwhile.
+func play_covered() -> bool:
+	var modal: bool = player != null and ((player.ui != null and player.ui.visible) or (player.craft_ui != null and player.craft_ui.visible))
+	return modal or sheet_open() or drawn_blocks.has("plate") or _death_alpha > 0.01 \
+		or (_animal_screen != null and _animal_screen.visible) or (_map_screen != null and _map_screen.visible)
+
