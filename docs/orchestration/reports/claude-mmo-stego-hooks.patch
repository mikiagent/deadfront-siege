+## The lowest bone at rest in each quarter around the feet: front left, front right, hind left, hind right.
+func _find_feet(sk: Skeleton3D) -> PackedInt32Array:
+	var to_view := RiggedModel._relative_to(sk, self)
+	var low: Dictionary = {}  ## bone -> rest position in this view's frame, bones within 15 % of the height
+	var mid := Vector3.ZERO
+	for b in sk.get_bone_count():
+		var p := to_view * sk.get_bone_global_rest(b).origin
+		if p.y < def.height_meters * 0.15 and sk.get_bone_parent(b) != -1:  # the root bone sits at the origin
+			low[b] = p
+			mid += p
+	mid /= maxf(1.0, float(low.size()))
+	var out := PackedInt32Array([-1, -1, -1, -1])
+	for b in low:
+		var p: Vector3 = low[b]
+		var q := (0 if p.z < mid.z else 2) + (0 if p.x < mid.x else 1)  # -Z is the front
+		if out[q] == -1 or p.y < (low[out[q]] as Vector3).y:
+			out[q] = b
+	return out if not out.has(-1) else PackedInt32Array()
+
+## Quadruped rigs on a slope: pitch and roll to the ground plane under the four feet and sit on it (the
+## body's round capsule bottom rides up a slope). Called from the creature's alive physics step.
+func conform_to_ground(delta: float) -> void:
+	var rt = World.runtime  # IslandRuntime (surface_y); typed Node3D on World
+	if _feet.is_empty() or rt == null:
+		return
+	var to_body := (get_parent() as Node3D).global_transform.affine_inverse()
+	var g: Array[Vector3] = []  ## the ground under each foot, in the creature's frame
+	for b in _feet:
+		var w := rig.skeleton.global_transform * rig.skeleton.get_bone_global_pose(b).origin
+		g.append(to_body * Vector3(w.x, float(rt.surface_y(w.x, w.z)), w.z))
+	var front := (g[0] + g[1]) * 0.5
+	var hind := (g[2] + g[3]) * 0.5
+	var left := (g[0] + g[2]) * 0.5
+	var right := (g[1] + g[3]) * 0.5
+	if hind.z - front.z < 0.1 or right.x - left.x < 0.05:
+		return
+	var dz := (hind.y - front.y) / (hind.z - front.z)  # ground plane y = lift + dx * x + dz * z
+	var dx := (right.y - left.y) / (right.x - left.x)
+	var c := (front + hind) * 0.5
+	var k := clampf(delta * 8.0, 0.0, 1.0)
+	rotation.x = lerpf(rotation.x, atan(-dz), k)  # nose up when the ground ahead (-Z) is higher
+	rotation.z = lerpf(rotation.z, atan(dx), k)
+	position.y = lerpf(position.y, c.y - dx * c.x - dz * c.z, k)
+
 func animation_player() -> AnimationPlayer:
 	if using_glb and rig:
 		return rig.anim_player
