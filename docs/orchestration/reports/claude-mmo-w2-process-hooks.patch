+
+## A status chip blocked where it stands (the survivor's figure, a HUD panel) steps sideways first, only
+## as far as its station's anchor stays under it, then tries hanging just under the anchor, over its own
+## station. Moving it a row up instead pushed the next station's chip up too, until in a dense camp row
+## each status hung over the wrong station.
+static func _slide_clear(item: Dictionary, taken: Array[Rect2]) -> void:
+	var w := minf(float(item["w"]), UiTokens.LABEL_MAX_W)
+	var h := float(item["h"])
+	var a: Vector2 = item["anchor"]
+	for dy: float in [0.0, h + 4.0]:
+		var dx := 0.0
+		while dx <= w * 0.5 - 12.0:
+			for x: float in [dx, -dx]:
+				var r := Rect2(a + Vector2(x - w * 0.5, dy - h), Vector2(w, h)).grow(2.0)
+				if not taken.any(func (t: Rect2) -> bool: return r.intersects(t)):
+					item["anchor"] = a + Vector2(x, dy)
+					return
+			dx += 4.0
