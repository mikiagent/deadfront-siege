+## W2-INV: a pre-instance save (stacked rows, def-id equipment) loads with every unit kept, one
+## instance per slot with its own uid; what the 100-slot bag cannot hold lands in home cargo.
+func _test_stacked_migration() -> void:
+	var src: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(FIX + "save_v3_stacked.json"))
+	src["player"]["inventory"][2]["count"] = 150 # 150 stone + 13 other units: more than the bag holds
+	var want := _units(src)
+	_clean()
+	_put(JSON.stringify(src))
+	SG.load_now(host)
+	_check(SG.blocked_reason == "", "the stacked save loads")
+	SG.save_now()
+	var s1 := _saved()
+	var got := _units(s1)
+	_check(got == want, "no unit is lost splitting stacks: %s vs %s" % [got, want])
+	var uids := {}
+	var multi := 0
+	var rows := 0
+	for row in _rows(s1):
+		var def = root.get_node("Data").item(StringName(str(row.get("id", ""))))
+		if def and def.stack_max == 1:
+			rows += 1
+			multi += 1 if int(row.get("count", 1)) != 1 else 0
+			uids[str(row.get("uid", ""))] = true
+	_check(multi == 0 and uids.size() == rows and not uids.has(""), "every non-stacking unit is its own row with a distinct uid (rows=%d uids=%d multi=%d)" % [rows, uids.size(), multi])
+	var worn: Dictionary = s1["player"]["inventory_extras"].get("worn", {})
+	_check(str(worn.get("head", {}).get("id", "")) == "raid_helm" and not s1["player"]["inventory_extras"].has("equipment"), "def-id head=raid_helm became a worn instance")
+	var bag_used := 0
+	for row in s1["player"]["inventory"]:
+		bag_used += 1 if row is Dictionary else 0
+	var cargo_stone := 0
+	for row in s1["home"]["cargo"]:
+		if row is Dictionary and str(row.get("id")) == "stone":
+			cargo_stone += int(row.get("count", 1))
+	# 99: the bag filled to 100, then the legacy head=raid_helm moved out of it into its slot.
+	_check(bag_used == 99 and (s1["player"]["inventory"] as Array).size() == 100 and cargo_stone > 0, "the bag fills to 100 and the rest goes to home cargo (bag=%d cargo stone=%d)" % [bag_used, cargo_stone])
+	SG.load_now(host)
+	SG.save_now()
+	var diffs: Array[String] = []
+	_same(s1, _saved(), "", diffs)
+	_check(diffs.is_empty(), "the migrated save re-saves unchanged: %s" % [diffs.slice(0, 4)])
+	print("[t_save] stacked migration units=%s bag=%d cargo_stone=%d instances=%d" % [got, bag_used, cargo_stone, rows])
+
+## Every item row in a save: bag, worn gear, home cargo, building contents, pet bags.
+func _rows(d: Dictionary) -> Array:
+	var out: Array = []
+	out.append_array(d.get("player", {}).get("inventory", []))
+	var extras: Dictionary = d.get("player", {}).get("inventory_extras", {})
+	out.append_array((extras.get("worn", {}) as Dictionary).values())
+	out.append_array(d.get("home", {}).get("cargo", []))
+	for b in d.get("home", {}).get("buildings", []) + d.get("away", {}).get("buildings", []):
+		out.append_array(b.get("contents", []))
+	for p in d.get("pets", []):
+		out.append_array(p.get("bag", []))
+	return out.filter(func (r: Variant) -> bool: return r is Dictionary)
+
+func _units(d: Dictionary) -> Dictionary:
+	var n := {}
+	for row in _rows(d):
+		n[str(row["id"])] = int(n.get(str(row["id"]), 0)) + int(row.get("count", 1))
+	return n
+
 func _test_forged() -> void:
 	_clean()
 	_put(FileAccess.get_file_as_string(FIX + "save_forged.json"))
 	SG.load_now(host)
 	var inv = player.inventory
