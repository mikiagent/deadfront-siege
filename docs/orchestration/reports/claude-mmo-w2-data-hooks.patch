+## requires_node names a trees.json node; node ids are unique across trees (t_data checks it).
+static func _node_unlocked(player: Player, node_id: String) -> bool:
+	if player == null or player.skills == null:
+		return false
+	for tree in player.skills.defs:
+		for n in player.skills.nodes(str(tree)):
+			if n is Dictionary and str((n as Dictionary).get("id", "")) == node_id:
+				return player.skills.is_unlocked(str(tree), node_id)
+	return false
+
 static func can_make(player: Player, rec: Dictionary, picks: Array[int]) -> bool:
